Windows Registry Editor Version 5.00



; Remove Switch User from the security screen.
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System]
"HideFastUserSwitching"=dword:00000001



; No edge swipes (Task View from the left, notifications from the right).
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\EdgeUI]
"AllowEdgeSwipe"=dword:00000000



; ---------------------------------------------------------------------
;  Microsoft Edge policies
; ---------------------------------------------------------------------
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge]
"HideFirstRunExperience"=dword:00000001
"DeveloperToolsAvailability"=dword:00000002
"InPrivateModeAvailability"=dword:00000001
"BrowserSignin"=dword:00000000
"SyncDisabled"=dword:00000001
"PasswordManagerEnabled"=dword:00000000
"AutofillAddressEnabled"=dword:00000000
"AutofillCreditCardEnabled"=dword:00000000
"TranslateEnabled"=dword:00000000
"EdgeCollectionsEnabled"=dword:00000000
"ShowRecommendationsEnabled"=dword:00000000
"PromotionalTabsEnabled"=dword:00000000
"EdgeShoppingAssistantEnabled"=dword:00000000
"UserFeedbackAllowed"=dword:00000000
"PrintingEnabled"=dword:00000000
"SavingBrowserHistoryDisabled"=dword:00000001
"DefaultNotificationsSetting"=dword:00000002
"DefaultGeolocationSetting"=dword:00000001
"BackgroundModeEnabled"=dword:00000000
"AllowFileSelectionDialogs"=dword:00000000
"DownloadRestrictions"=dword:00000003

; Whitelist browsing. Even if someone escapes the app, there is nowhere
; to go. ADD YOUR OWN PORTAL / SERVICE HOSTS to the allow list before
; applying, or the app will break.
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge\URLBlocklist]
"1"="*"

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge\URLAllowlist]
"1"="file:///C:/Kiosk/"
"2"="arcgis.com"
"3"="arcgisonline.com"
"4"="arcgis.net"
"5"="vimeo.com"
"6"="vimeocdn.com"
"7"="sidagis.github.io"
"8"="githubusercontent.com"
"9"="sodir.no"
"10"="fonts.googleapis.com"
"11"="fonts.gstatic.com"

; ---------------------------------------------------------------------
;  Stop Edge updating itself during opening hours. The command-line
;  --check-for-update-interval does NOT affect the EdgeUpdate service.
;  0 = updates disabled. Use 3 (manual only) if you would rather patch
;  by hand; either way it must not happen unattended mid-event.
; ---------------------------------------------------------------------
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\EdgeUpdate]
"UpdateDefault"=dword:00000000
"AutoUpdateCheckPeriodMinutes"=dword:00000000
"InstallDefault"=dword:00000000

; Cap the browser cache so a profile that lives for months cannot fill
; the disk. 262144000 = 250 MB.
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge]
"DiskCacheSize"=dword:0fa00000
