<!DOCTYPE html>
<html>
<head>
<style>
  html, body { margin: 0; padding: 0; overflow: hidden; background: #000; }
  /* iframe is the portrait size (1080x1920), rotated to fit the 1920x1080 landscape test screen */
#frame {
  position: absolute;
  /* center a 1080x1920 box in the 1920x1080 viewport */
  top: 50%;
  left: 50%;
  width: 1080px;
  height: 1920px;
  margin-top: -960px;    /* -height/2 */
  margin-left: -540px;   /* -width/2 */
  transform: rotate(270deg);   /* or 90deg — just flip this, no translate to fix */
  transform-origin: center center;
}
</style>
</head>
<body>
  <iframe id="frame" src="https://sidagis.github.io/ONS/theMap.html"></iframe>
</body>
</html>
